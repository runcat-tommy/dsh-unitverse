{
  "name": "dsh-unit-conversion",
  "version": "0.1.0",
  "description": "DSH plugin: universal unit conversion across length, area, volume, time, angle, speed, temperature, pressure, energy and power, with Chinese/English aliases. 单位换算 DSH 插件（长度/面积/体积/时间/角度/速度/温度/压力/热量/功率，支持中英文单位名）。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "unit-conversion",
    "units",
    "convert",
    "单位换算"
  ],
  "license": "MIT",
  "author": "runcat-tommy",
  "repository": {
    "type": "git",
    "url": "https://github.com/runcat-tommy/dsh-unit-conversion.git"
  },
  "homepage": "https://github.com/runcat-tommy/dsh-unit-conversion",
  "bugs": {
    "url": "https://github.com/runcat-tommy/dsh-unit-conversion/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./convert": {
      "types": "./lib/convert.d.ts",
      "import": "./lib/convert.js",
      "require": "./lib/convert.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@types/node": "^26.5.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
